# Copy to .env.local and fill in. Never commit real values.

# Gmail (OAuth client + refresh token for the demo inbox; see npm run gmail:check)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# LLM gateway (OpenAI-compatible)
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1

# Only mail delivered to this address is treated as an RFQ
RFQ_ADDRESS=you+rfq@gmail.com

# Optional: override the reader models
TEXT_MODEL=openai/gpt-5.4-mini
PDF_MODEL=anthropic/claude-sonnet-5
